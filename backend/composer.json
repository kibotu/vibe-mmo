{
  "name": "kibotu/mmo-backend",
  "description": "Authoritative PHP WebSocket backend for the Payon Forest MMO",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.5 <8.6",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "amphp/websocket-server": "^4.0",
    "monolog/monolog": "^3.9",
    "symfony/yaml": "^7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Mmo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mmo\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src public bin tests docker -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": {
      "*": "dist"
    }
  }
}
